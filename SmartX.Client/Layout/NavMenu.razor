    </MudText>

    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        Home
    </MudNavLink>

    <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">
        Dashboard
    </MudNavLink>


    <MudText Typo="Typo.overline" Class="px-4 mt-4 mb-1">
        Devices
    </MudText>

    <MudNavLink Href="/sensors" Icon="@Icons.Material.Filled.Sensors">
