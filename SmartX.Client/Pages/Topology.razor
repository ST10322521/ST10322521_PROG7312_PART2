@page "/topology"
@using Blazor.Diagrams.Components
@using SmartX.Shared.Models.Topology

@* https://blazor-diagrams.zhaytam.com/documentation/display *@

<PageTitle>Network Topology</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">
    Network Topology & Mesh Routing
</MudText>

@if (loading)
{
    <MudPaper Class="pa-6">
        <MudProgressCircular Indeterminate="true" />
        <MudText Class="mt-3">Loading network topology...</MudText>
    </MudPaper>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error">
        @errorMessage
    </MudAlert>
}
else if (topology is null)
{
    <MudAlert Severity="Severity.Warning">
        No network topology data is available.
    </MudAlert>
}
else
{
    <MudGrid>
        @* Display the network topology summary and graph *@
        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h5">
                        IoT Mesh Network
                    </MudText>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="RefreshTopologyAsync" Disabled="@loading">
                        Refresh
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>

        @* Display the network topology summary cards *@
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.overline">Nodes</MudText>
                <MudText Typo="Typo.h4">@topology.Nodes.Count</MudText>
            </MudPaper>
        </MudItem>

        @* Display the online nodes count *@
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.overline">Online</MudText>
                <MudText Typo="Typo.h4">@OnlineNodeCount</MudText>
            </MudPaper>
        </MudItem>

        @* Display the offline nodes count *@
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.overline">Offline</MudText>
                <MudText Typo="Typo.h4">@OfflineNodeCount</MudText>
            </MudPaper>
        </MudItem>

        @* Display the connections count *@
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.overline">Connections</MudText>
                <MudText Typo="Typo.h4">@topology.Edges.Count</MudText>
            </MudPaper>
        </MudItem>

        @* Display the interactive network topology graph *@
        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h5" Class="mb-4">
                    Network Graph
                </MudText>

                <div class="topology-diagram-container">
                    <CascadingValue Value="Diagram" IsFixed="true">
                        <DiagramCanvas />
                    </CascadingValue>
                </div>
            </MudPaper>
        </MudItem>

        @* Display BFS traversal and reachability results *@
        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h5" Class="mb-4">
                    BFS Network Traversal
                </MudText>

                <MudText Typo="Typo.body2" Class="mb-2">
                    Starting node:
                    <strong>@topology.GatewayNodeId</strong>
                </MudText>

                <MudText Typo="Typo.body2" Class="mb-3">
                    Traversal order:
                </MudText>

                @if (topology.GatewayTraversalOrder.Count > 0)
                {
                    <MudText Typo="Typo.body1">
                        @string.Join(" → ", topology.GatewayTraversalOrder)
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2">
                        No reachable nodes were found.
                    </MudText>
                }

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.body2">
                    Reachable nodes:
                    <strong>@topology.ReachableNodeIds.Count</strong>
                </MudText>

                @if (topology.DisconnectedNodeIds.Count == 0)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-3">
                        All network nodes are reachable from the gateway.
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-3">
                        Disconnected nodes:
                        @string.Join(", ", topology.DisconnectedNodeIds)
                    </MudAlert>
                }
            </MudPaper>
        </MudItem>

        @* Display the route to the gateway *@
        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h5" Class="mb-4">
                    Route to Gateway
                </MudText>

                <MudSelect T="string" @bind-Value="selectedRouteNodeId" Label="Select sensor" Variant="Variant.Outlined"
                           Class="mb-3">

                    @foreach (var node in topology.Nodes.Where(n => !n.IsGateway))
                    {
                        <MudSelectItem T="string" Value="@node.Id">
                            @node.Id (@node.Status)
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@routeLoading"
                           OnClick="FindRouteToGatewayAsync">

                    @(routeLoading ? "Finding Route..." : "Find Route")
                </MudButton>

                @if (!string.IsNullOrWhiteSpace(routeError))
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-4">
                        @routeError
                    </MudAlert>
                }

                @if (selectedRoute.Count > 0)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-4">
                        <strong>Route:</strong>
                        @string.Join(" → ", selectedRoute)
                    </MudAlert>
                }
            </MudPaper>
        </MudItem>

        @* Display the network connections in a table *@
        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h5" Class="mb-4">
                    Network Connections
                </MudText>

                <MudTable Items="@topology.Edges" Hover="true" Dense="true" Striped="true">

                    <HeaderContent>
                        <MudTh>Source</MudTh>
                        <MudTh>Target</MudTh>
                        <MudTh>Weight</MudTh>
                        <MudTh>Status</MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd DataLabel="Source">
                            @context.SourceNodeId
                        </MudTd>

                        <MudTd DataLabel="Target">
                            @context.TargetNodeId
                        </MudTd>

                        <MudTd DataLabel="Weight">
                            @context.Weight
                        </MudTd>

                        <MudTd DataLabel="Status">
                            <MudChip T="string" Color="@(context.IsActive
                                     ? Color.Success
                                     : Color.Error)" Size="Size.Small">
                                @(context.IsActive ? "Active" : "Inactive")
                            </MudChip>
                        </MudTd>
                    </RowTemplate>

                </MudTable>
            </MudPaper>
        </MudItem>

        @* Display the minimum spanning tree calculated by Prim's algorithm *@
        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h5" Class="mb-4">
                    Minimum Spanning Tree (Prim)
                </MudText>

                <MudText Typo="Typo.body2" Class="mb-3">
                    Prim's algorithm uses the Min-Heap to select the lowest-cost
                    available network connection at each step.
                </MudText>

                @if (MinimumSpanningTreeEdges.Count == 0)
                {
                    <MudAlert Severity="Severity.Warning">
                        No minimum spanning tree could be calculated from the current topology.
                    </MudAlert>
                }
                else
                {
                    <MudTable Items="@MinimumSpanningTreeEdges" Hover="true" Dense="true" Striped="true">
                        <HeaderContent>
                            <MudTh>Source</MudTh>
                            <MudTh>Target</MudTh>
                            <MudTh>Weight</MudTh>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd DataLabel="Source">
                                @context.SourceNodeId
                            </MudTd>

                            <MudTd DataLabel="Target">
                                @context.TargetNodeId
                            </MudTd>

                            <MudTd DataLabel="Weight">
                                @context.Weight
                            </MudTd>
                        </RowTemplate>
                    </MudTable>

                    <MudDivider Class="my-4" />

                    <MudStack Row="true" Spacing="4">
                        <MudText Typo="Typo.body1">
                            MST edges: <strong>@MinimumSpanningTreeEdges.Count</strong>
                        </MudText>

                        <MudText Typo="Typo.body1">
                            Total cost: <strong>@MinimumSpanningTreeCost</strong>
                        </MudText>
                    </MudStack>
                }
            </MudPaper>
        </MudItem>

        @* Display the last updated timestamp of the topology data *@
        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.body2">
                    Last updated:
                    @topology.LastUpdated.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                </MudText>
            </MudPaper>
        </MudItem>

    </MudGrid>
}