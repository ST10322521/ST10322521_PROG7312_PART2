@page "/history"
@using SmartX.Shared.Enums

<PageTitle>Telemetry History</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">
    Telemetry History
</MudText>

<MudPaper Class="pa-4">

    <MudText Typo="Typo.h6" Class="mb-3">
        Historical Telemetry Range Query
    </MudText>
    
    <div class="d-flex flex-wrap gap-3 mb-4">

        @* Select the device for which to view historical telemetry *@
        <MudSelect T="string" @bind-Value="selectedDeviceId" Label="Select device" Variant="Variant.Outlined"
                   Style="min-width:280px;">

            @foreach (var deviceId in deviceIds)
            {
                <MudSelectItem Value="@deviceId">
                    @deviceId
                </MudSelectItem>
            }

        </MudSelect>
        @* Select the type of telemetry to view *@
        <MudSelect T="TelemetryType" @bind-Value="selectedTelemetryType" Label="Telemetry type"
                   Variant="Variant.Outlined" Style="min-width:220px;">

            @foreach (var telemetryType in Enum.GetValues<TelemetryType>())
            {
                <MudSelectItem Value="@telemetryType">
                    @telemetryType
                </MudSelectItem>
            }

        </MudSelect>
        
        <MudDatePicker @bind-Date="startDate" Label="From date" Variant="Variant.Outlined" DateFormat="yyyy-MM-dd"
                       Clearable="true" />

        <MudTimePicker @bind-Time="startTime" Label="From time" Variant="Variant.Outlined" AmPm="false" />

        <MudDatePicker @bind-Date="endDate" Label="To date" Variant="Variant.Outlined" DateFormat="yyyy-MM-dd"
                       Clearable="true" />

        <MudTimePicker @bind-Time="endTime" Label="To time" Variant="Variant.Outlined" AmPm="false" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search"
                   Disabled="@(loading || string.IsNullOrWhiteSpace(selectedDeviceId))" OnClick="QueryHistoryAsync">

            Query History

        </MudButton>

    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @error
        </MudAlert>
    }

    @if (loading)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
    }

    @if (!loading && history.Count == 0 && hasQueriedRange)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            No telemetry records match the selected device, telemetry type,
            and time range.
        </MudAlert>
    }
    else if (!loading &&
             history.Count == 0 &&
             !string.IsNullOrWhiteSpace(selectedDeviceId) &&
             !hasQueriedRange)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            No historical telemetry is available for this device yet.
        </MudAlert>
    }

    @if (history.Count > 0)
    {
        <MudText Typo="Typo.h6" Class="mb-3">
            Query Results
        </MudText>

        <MudTable Items="history" Hover="true" Dense="true" Striped="true">

            <HeaderContent>
                <MudTh>Timestamp</MudTh>
                <MudTh>Device</MudTh>
                <MudTh>Telemetry Type</MudTh>
                <MudTh>Value</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Timestamp">
                    @context.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                </MudTd>

                <MudTd DataLabel="Device">
                    @context.DeviceId
                </MudTd>

                <MudTd DataLabel="Telemetry Type">
                    @context.TelemetryType
                </MudTd>

                <MudTd DataLabel="Value">
                    @context.Value.ToString("0.##")
                </MudTd>
            </RowTemplate>

        </MudTable>
    }

</MudPaper>