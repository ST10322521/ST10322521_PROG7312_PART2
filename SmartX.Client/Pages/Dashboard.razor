@page "/"

<PageTitle>Smart-X Dashboard</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Smart-X Live Dashboard</MudText>

@if (!string.IsNullOrWhiteSpace(error))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @error
    </MudAlert>
}

<div class="d-flex flex-wrap gap-4 mb-4">

    <MudPaper Class="pa-4" Style="min-width:180px;">
        <MudText Typo="Typo.caption">Registered Sensors</MudText>
        <MudText Typo="Typo.h4">@sensors.Count</MudText>
    </MudPaper>

    <MudPaper Class="pa-4" Style="min-width:180px;">
        <MudText Typo="Typo.caption">Active Sensors</MudText>
        <MudText Typo="Typo.h4">@latestTelemetry.Count</MudText>
    </MudPaper>

    <MudPaper Class="pa-4" Style="min-width:180px;">
        <MudText Typo="Typo.caption">Live Readings</MudText>
        <MudText Typo="Typo.h4">@latestTelemetry.Count</MudText>
    </MudPaper>

    <MudPaper Class="pa-4" Style="min-width:180px;">
        <MudText Typo="Typo.caption">Anomalies</MudText>
        <MudText Typo="Typo.h4">@anomalyCount</MudText>
    </MudPaper>

</div>

<MudPaper Class="pa-4 mb-4">

    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h6">
            Active Alerts &amp; Disconnected Devices
        </MudText>

        <MudChip T="string" Size="Size.Small" Color="@(activeErrorStates.Count > 0 || disconnectedDevices.Count > 0
                     ? Color.Error
                     : Color.Success)">
            @(activeErrorStates.Count + disconnectedDevices.Count) Active
        </MudChip>
    </div>

    @if (activeErrorStates.Count == 0 && disconnectedDevices.Count == 0)
    {
        <MudAlert Severity="Severity.Success">
            No active error states or disconnected devices.
        </MudAlert>
    }
    else
    {
        @foreach (var errorState in activeErrorStates)
        {
            <MudAlert Severity="Severity.Error" Class="mb-2">
                <strong>Active Error:</strong> @errorState
            </MudAlert>
        }

        @foreach (var deviceId in disconnectedDevices)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">
                <strong>Disconnected:</strong> @deviceId
            </MudAlert>
        }
    }

</MudPaper>

<MudPaper Class="pa-4 mb-4">

    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h6">Live Telemetry</MudText>

        <MudChip T="string" Size="Size.Small" Color="@(signalRConnected ? Color.Success : Color.Error)">
            @(signalRConnected ? "SignalR Connected" : "SignalR Disconnected")
        </MudChip>
    </div>

    @if (latestTelemetry.Count == 0)
    {
        <MudText Typo="Typo.body2">
            Waiting for live telemetry...
        </MudText>
    }
    else
    {
        <MudTable Items="latestTelemetry.Values.OrderBy(x => x.DeviceId)" Hover="true" Dense="true" Striped="true">

            <HeaderContent>
                <MudTh>Device</MudTh>
                <MudTh>Telemetry</MudTh>
                <MudTh>Value</MudTh>
                <MudTh>Change</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Timestamp</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Device">
                    @context.DeviceId
                </MudTd>

                <MudTd DataLabel="Telemetry">
                    @context.TelemetryType
                </MudTd>

                <MudTd DataLabel="Value">
                    <MudText Typo="Typo.body2">
                        @context.Value
                    </MudText>
                </MudTd>

                <MudTd DataLabel="Change">
                    @(context.Delta.HasValue ? context.Delta.Value.ToString("0.##") : "—")
                </MudTd>

                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                        @context.Status
                    </MudChip>
                </MudTd>

                <MudTd DataLabel="Timestamp">
                    @context.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                </MudTd>
            </RowTemplate>

        </MudTable>
    }

</MudPaper>

<MudPaper Class="pa-4">

    <MudText Typo="Typo.h6" Class="mb-3">
        Recent Anomalies
    </MudText>

    @if (recentAnomalies.Count == 0)
    {
        <MudText Typo="Typo.body2">
            No anomalies detected yet.
        </MudText>
    }
    else
    {
        @foreach (var telemetry in recentAnomalies)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">
                <strong>@telemetry.DeviceId</strong>
                — @telemetry.TelemetryType:
                @telemetry.Value
                (@telemetry.Status)
            </MudAlert>
        }
    }

</MudPaper>
